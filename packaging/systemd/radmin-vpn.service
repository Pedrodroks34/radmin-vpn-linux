[Unit]
Description=Radmin VPN service (Rust, TAP owner)
Documentation=https://github.com/Pedrodroks34/radmin-vpn-linux
After=graphical-session.target
Wants=graphical-session.target
ConditionPathExists=/dev/net/tun
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStart=/usr/bin/radmin-vpn --json-logs service
ExecReload=/bin/kill -s SIGHUP $MAINPID
ExecStop=/usr/bin/radmin-vpn teardown --tap-dev radminvpn0
ExecStopPost=/usr/bin/radmin-vpn teardown --tap-dev radminvpn0 --remove-tap
Restart=always
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=20
RuntimeDirectory=radmin-vpn
RuntimeDirectoryMode=0750
StateDirectory=radmin-vpn
StateDirectoryMode=0750
Environment=RVPN_BUILD_DIR=/usr/lib/radmin-vpn

# Privilege model: the user manager cannot grant capabilities to children,
# so AmbientCapabilities/CapabilityBoundingSet are omitted (they make the user
# service fail to spawn). Instead /usr/bin/radmin-vpn carries file caps
# (cap_net_admin,cap_net_raw=ep), installed via setcap by the package
# postinst / `make install`. NoNewPrivileges must stay disabled so the file
# caps are honoured on exec.
#
# NOTE: namespace-based hardening (ProtectSystem, RestrictSUIDSGID,
# LockPersonality, RestrictAddressFamilies, PrivateTmp=true, ...) must NOT be
# used here: any of them runs the unit inside a user namespace, where the
# file capabilities do not apply to the host network namespace and the TAP
# ioctl (or netlink route/address operations) fails with EPERM.
NoNewPrivileges=false
ProtectHome=false
PrivateTmp=false

[Install]
WantedBy=default.target
